# FixAI Backend Configuration
# Copy this to .env and fill in values

# Database URL (default: SQLite async for development)
DATABASE_URL=sqlite+aiosqlite:///./fixai.db

# JWT Secret - CHANGE IN PRODUCTION
JWT_SECRET=fixai-super-secret-key-change-in-production

# Device API Key for agent authentication
CONVEX_DEVICE_API_KEY=fixai-device-secret-key-2026
